<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_receipt_layout" model="ir.ui.view">
        <field name="name">res.config.settings.form.pos.receipt.layout</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_bills_and_receipts_section']" position="inside">
                <setting id="pos_receipt_layout" string="Receipt Layout"
                         help="Logo, company name and details, customer details and a table of order lines">
                    <field name="pos_use_customized_receipt"/>
                    <div class="content-group mt16" invisible="not pos_use_customized_receipt">
                        <div class="row">
                            <label for="pos_receipt_logo" string="Logo" class="col-lg-4 o_light_label"/>
                            <field name="pos_receipt_logo" widget="image" class="col-lg-8" options="{'size': [0, 90]}"/>
                        </div>
                        <div class="row mt8">
                            <label for="pos_company_name" string="Company Name" class="col-lg-4 o_light_label"/>
                            <field name="pos_company_name" class="col-lg-8"/>
                        </div>
                        <div class="row mt8">
                            <label for="pos_company_details" string="Company Details" class="col-lg-4 o_light_label"/>
                            <field name="pos_company_details" class="col-lg-8"/>
                        </div>
                        <div class="row mt8">
                            <label for="pos_show_customer_details" string="Customer Details" class="col-lg-4 o_light_label"/>
                            <field name="pos_show_customer_details" class="col-lg-8"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
