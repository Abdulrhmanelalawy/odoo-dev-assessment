<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_order_line_salesperson" model="ir.ui.view">
        <field name="name">pos.order.line.list.salesperson</field>
        <field name="model">pos.order.line</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_line"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="salesperson_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_pos_order_line_all_sales_salesperson" model="ir.ui.view">
        <field name="name">pos.order.line.all.sales.list.salesperson</field>
        <field name="model">pos.order.line</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree_all_sales_lines"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="salesperson_id" optional="show"/>
            </field>
        </field>
    </record>

    <!-- Odoo 19 has no menu for POS order lines: expose them, with salesperson filters -->
    <record id="view_pos_order_line_search_salesperson" model="ir.ui.view">
        <field name="name">pos.order.line.search.salesperson</field>
        <field name="model">pos.order.line</field>
        <field name="arch" type="xml">
            <search string="POS Order Lines">
                <field name="order_id"/>
                <field name="product_id"/>
                <field name="salesperson_id"/>
                <filter name="with_salesperson" string="With Salesperson" domain="[('salesperson_id', '!=', False)]"/>
                <filter name="without_salesperson" string="Without Salesperson" domain="[('salesperson_id', '=', False)]"/>
                <group>
                    <filter name="group_salesperson" string="Salesperson" context="{'group_by': 'salesperson_id'}"/>
                    <filter name="group_order" string="Order" context="{'group_by': 'order_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pos_order_line_salesperson" model="ir.actions.act_window">
        <field name="name">Order Lines</field>
        <field name="res_model">pos.order.line</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="point_of_sale.view_pos_order_line"/>
        <field name="search_view_id" ref="view_pos_order_line_search_salesperson"/>
    </record>

    <menuitem id="menu_pos_order_line_salesperson"
              name="Order Lines"
              parent="point_of_sale.menu_point_of_sale"
              action="action_pos_order_line_salesperson"
              groups="point_of_sale.group_pos_manager"
              sequence="3"/>

    <!-- Order form, "Products" tab -->
    <record id="view_pos_pos_form_salesperson" model="ir.ui.view">
        <field name="name">pos.order.form.salesperson</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lines']/list/field[@name='product_id']" position="after">
                <field name="salesperson_id" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
