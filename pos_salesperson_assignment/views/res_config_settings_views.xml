<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_salesperson" model="ir.ui.view">
        <field name="name">res.config.settings.form.pos.salesperson</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="inside">
                <setting id="pos_salesperson_assignment" string="Salesperson Assignment"
                         help="Credit a salesperson on each order line or on the whole order">
                    <field name="pos_active_salesperson_feature"/>
                    <div class="content-group mt16" invisible="not pos_active_salesperson_feature">
                        <field name="pos_allowed_sale_person_ids" widget="many2many_tags"
                               placeholder="All salespersons" options="{'no_create': True}"/>
                        <div>
                            <button name="%(pos_salesperson_assignment.action_pos_sale_person)d" type="action"
                                    string="Salespersons" icon="oi-arrow-right" class="btn-link"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
