<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report options wizard: period, options, filters and the three output buttons. -->
    <record id="view_dynamic_trial_balance_wizard_form" model="ir.ui.view">
        <field name="name">dynamic.trial.balance.wizard.form</field>
        <field name="model">dynamic.trial.balance.wizard</field>
        <field name="arch" type="xml">
            <form string="Dynamic Trial Balance">
                <field name="company_id" invisible="1"/>
                <group>
                    <group string="Period">
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group string="Options">
                        <field name="include_unposted"/>
                        <field name="hierarchy" readonly="only_parents"/>
                        <field name="only_parents"/>
                        <field name="account_level" invisible="not only_parents" required="only_parents"/>
                        <field name="skip_zero_balance"/>
                        <field name="show_amount_currency"/>
                    </group>
                </group>
                <group string="Filters">
                    <field name="account_prefix_ids" widget="many2many_tags"
                           placeholder="e.g. 1, 40, 6011 (leave empty for all accounts)"
                           options="{'no_create_edit': True}"/>
                    <field name="journal_ids" widget="many2many_tags" options="{'no_create': True}"
                           placeholder="All journals"/>
                    <field name="analytic_account_ids" widget="many2many_tags" options="{'no_create': True}"
                           placeholder="All analytic accounts"/>
                </group>
                <footer>
                    <button name="action_preview" string="Preview" type="object" class="btn-primary" data-hotkey="q"/>
                    <button name="action_pdf" string="PDF" type="object" class="btn-secondary" data-hotkey="w"/>
                    <button name="action_xlsx" string="XLSX" type="object" class="btn-secondary" data-hotkey="e"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dynamic_trial_balance_wizard" model="ir.actions.act_window">
        <field name="name">Dynamic Trial Balance</field>
        <field name="res_model">dynamic.trial.balance.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
